{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)"
    ],
    "deny": [
      "Read(./agentbox/.env)",
      "Read(./**/.env)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ask-before-publish.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
