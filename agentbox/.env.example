# KIWI/agentbox/.env - secrets and machine settings (git-ignored). Keep private: chmod 600 .env
# (Docker Compose also reads this file for the variables at the bottom.)

# Fine-grained PAT for the ORCHESTRATOR (resource owner: your agent org).
# Repository access: All repositories. Permissions (read and write): Administration,
# Contents, Issues, Pull requests, Workflows. Read-only: Actions, Metadata.
GH_ADMIN_TOKEN=github_pat_xxx

# Fine-grained PAT for the MODELS via the GitHub MCP server (same resource owner).
# Repository access: All repositories. Permissions: READ-ONLY Contents, Issues, Pull requests, Metadata.
GH_AGENT_TOKEN=github_pat_yyy

# Optional: Hugging Face token (only if downloads are rate-limited)
HF_TOKEN=

# ---- Docker Compose settings ----
# Absolute path (setup-wsl.sh fills it in); docker compose does not expand ~
MODELS_DIR=/home/YOUR_WSL_USER/agentbox-runtime/models
LLAMA_SWAP_PORT=8080
# This laptop has no NVIDIA GPU: the CPU image + override (select-profile.sh sets these).
COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml
AGENTBOX_PROFILE=32gb-cpu
# Pin an exact image once things work, e.g. ghcr.io/mostlygeek/llama-swap:<tag>-cpu (see GitHub packages)
LLAMA_SWAP_IMAGE_CPU=ghcr.io/mostlygeek/llama-swap:cpu
# NVIDIA machines only:
LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap:unified-cuda
